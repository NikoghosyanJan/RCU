generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FilingStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  ABANDONED
}

enum OrderStatus {
  PAID
  PROCESSING
  FILED
  COMPLETED
  REFUNDED
  CANCELLED
}

model Filing {
  id               String       @id @default(cuid())
  status           FilingStatus @default(DRAFT)
  applicantName    String
  email            String
  phone            String
  registrationYear Int
  usdotNumber      String
  legalName        String?
  dbaName          String?
  mcNumber         String?
  address          String?
  city             String?
  state            String?
  zip              String?
  entityType       String?
  vehicleCount     Int?
  feeBracket       String?
  ucrFeeCents      Int?
  serviceFeeCents  Int?
  totalCents       Int?
  agreedTermsAt    DateTime?
  remindRenewal    Boolean      @default(true)
  lsCheckoutId     String?
  order            Order?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([usdotNumber])
  @@index([email])
}

model Order {
  id          String       @id @default(cuid())
  orderNumber String       @unique
  filingId    String       @unique
  filing      Filing       @relation(fields: [filingId], references: [id])
  lsOrderId   String       @unique
  amountCents Int
  receiptUrl  String?
  status      OrderStatus  @default(PAID)
  events      OrderEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}
