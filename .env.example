# Neon Postgres
# Pooled connection (host contains "-pooler") used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection used by Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# FMCSA QCMobile API (https://mobile.fmcsa.dot.gov/QCDevsite/)
FMCSA_WEBKEY=""

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# "true" while using Lemon Squeezy test mode
LEMONSQUEEZY_TEST_MODE="true"

# Resend
RESEND_API_KEY=""
EMAIL_FROM="UCR Filing Service <orders@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="UCR Filing Service"
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"
NEXT_PUBLIC_SUPPORT_PHONE="(800) 555-0100"

# Flat service fee added to the official UCR fee, in cents
SERVICE_FEE_CENTS="4900"

# Admin
ADMIN_PASSWORD=""
# Random string of at least 32 characters (e.g. `openssl rand -base64 32`)
ADMIN_SESSION_SECRET=""
