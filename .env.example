# Neon Postgres
# Pooled connection (host contains "-pooler") used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection used by Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# FMCSA QCMobile API (https://mobile.fmcsa.dot.gov/QCDevsite/)
# While empty, USDOT 000000 returns built-in test company data without calling FMCSA
FMCSA_WEBKEY=""

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# "true" while using Lemon Squeezy test mode
LEMONSQUEEZY_TEST_MODE="true"

# Resend
RESEND_API_KEY=""
EMAIL_FROM="UCR Filing Service <orders@getucrfiling.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="UCR Filing Service"
NEXT_PUBLIC_SUPPORT_EMAIL="support@getucrfiling.com"
NEXT_PUBLIC_SUPPORT_PHONE="(800) 555-0100"

# Legal details shown on the Terms, Privacy and Refund pages and in the footer
# Registered name exactly as on the state registration certificate
NEXT_PUBLIC_LEGAL_ENTITY_NAME="Individual Entrepreneur Firstname Lastname"
NEXT_PUBLIC_LEGAL_ADDRESS="Street 1, apt 1, Yerevan 0001, Republic of Armenia"
# Optional: taxpayer ID (TIN) or state registration number; hidden when empty
NEXT_PUBLIC_LEGAL_REG_NUMBER=""
# Jurisdiction whose law governs the Terms, phrased to follow "the laws of"
NEXT_PUBLIC_GOVERNING_LAW="the Republic of Armenia"
# Where disputes are resolved, phrased to follow "the competent courts of"
NEXT_PUBLIC_DISPUTE_VENUE="Yerevan, Republic of Armenia"

# Flat service fee added to the official UCR fee, in cents
SERVICE_FEE_CENTS="4900"

# Admin
ADMIN_PASSWORD=""
# Random string of at least 32 characters (e.g. `openssl rand -base64 32`)
ADMIN_SESSION_SECRET=""
